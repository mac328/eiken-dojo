node_modules/

# ルートの index.html / audio/ から自動生成される Capacitor ビルド対象
# （npm run sync:www で再生成できるためコミット不要）
www/

# 声とピッチの聴きくらべ用の一時ファイル
# （tools/try_voice_pitch.py でいつでも作りなおせる）
audio_test/

# tools/try_voices.py の出力（声の聴きくらべ用）
audio_voices/

# Python が自動で作る中間ファイル
__pycache__/
*.pyc

# tools/make_icons.py の確認用プレビュー
# （--install なしで実行すればいつでも作りなおせる）
icon_preview/

# 署名鍵とそのパスワード。ぜったいにコミットしない。
# アップロード鍵は失っても Play Console から再発行を申請できるが、
# 流出すると第三者があなたのアプリとして偽物を投稿できてしまう。
*.jks
*.keystore
keystore.properties
